{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LuHoo/ada/schemas/manuscript-calculation-registry-v1.json",
  "title": "ADA Manuscript Calculation Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "chapter_prefix",
    "source_notebook",
    "source_context",
    "tolerance",
    "language_scope",
    "values"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(pro|est|aux|hyp|reg|gof)\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
    },
    "kind": {
      "enum": [
        "worked_calculation",
        "inline_values",
        "table_values",
        "report_only"
      ]
    },
    "chapter_prefix": {
      "enum": [
        "pro",
        "est",
        "aux",
        "hyp",
        "reg",
        "gof"
      ]
    },
    "source_notebook": {
      "type": "string",
      "pattern": "^notebooks/support/.+/support\\.Rmd$"
    },
    "source_context": {
      "type": "string",
      "minLength": 1
    },
    "source_dataset": {
      "type": "string",
      "minLength": 1
    },
    "target_snippet": {
      "type": "string",
      "pattern": "^generated/worked-calculations/.+\\.tex$"
    },
    "tolerance": {
      "type": "number",
      "minimum": 0
    },
    "language_scope": {
      "enum": [
        "shared",
        "r",
        "python",
        "exception"
      ]
    },
    "equation_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^eq:[A-Za-z0-9_:-]+$"
      },
      "uniqueItems": true
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/value"
      }
    }
  },
  "$defs": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "raw",
        "display",
        "format"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(pro|est|aux|hyp|reg|gof)\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "raw": {
          "type": "number"
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "pattern": "^(integer|number:[0-9]+|percentage:[0-9]+|pvalue:[0-9]+|statistic:[0-9]+)$"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "language_scope": {
          "enum": [
            "shared",
            "r",
            "python",
            "exception"
          ]
        }
      }
    }
  }
}
