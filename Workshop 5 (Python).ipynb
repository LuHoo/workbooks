        "    response='revenue',\n",
        "    candidates=['production', 'coolDD', 'heatDD'],\n",
        "    direction='forward',\n",
        "    start_terms=[],\n",
        ")\n",
        "print('Forward terms:', model_forward_terms)\n",
        "print(model_forward.summary())\n"
      ]
    },
