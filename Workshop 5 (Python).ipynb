            "fence_close_line": 313,
            "fence_open_line": 310,
            "start_line": 310
          }
        }
      },
      "outputs": [],
      "source": [
        "ussteamco_mod_0 = fit_lm('ussteamco_mod_0', 'revenue ~ production', USSteamCoEstim)\n",
        "brief_model('ussteamco_mod_0')\n"
      ]
    },
